# 粤港甄选企业版部署环境变量模板
# 使用方法：复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略）
# cp .env.example .env

# 镜像仓库（默认 ghcr.io）
# YGH_REGISTRY=ghcr.io/wangzaiwang-hub

# 镜像版本标签（CI 中由 workflow 注入 ci）
YGH_VERSION=ci

# MySQL
MYSQL_ROOT_PASSWORD=change-me

# Redis
REDIS_PASSWORD=change-me

# pgvector (PostgreSQL)
POSTGRES_PASSWORD=change-me

# Elasticsearch
ELASTIC_PASSWORD=change-me

# Nacos（连接 MySQL 的账号密码 + 鉴权配置）
NACOS_DB_PASSWORD=change-me
NACOS_AUTH_TOKEN=change-me-please-use-a-long-random-string
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=security

# Grafana
GRAFANA_ADMIN_PASSWORD=change-me
